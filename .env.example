# Copy this file to .env and fill in your bot token.
TELEGRAM_BOT_TOKEN=123456:ABCDEF
# Optional settings
VIDEO_OUTPUT_DIR=videos
VIDEO_DURATION=60
# Ключ авторизации из личного кабинета GigaChat API
GIGACHAT_AUTH_KEY=your-authorization-key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Путь к корневому сертификату Минцифры с https://www.gosuslugi.ru/crt
GIGACHAT_CA_BUNDLE_FILE=russian_trusted_root_ca.cer
MAX_PARALLEL_RENDERS=1
